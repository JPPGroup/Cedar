<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <RootNamespace>JPP.StandardDocuments</RootNamespace>	  
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Calculation Report Template.docx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Calculation Report Template.docx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\submodules\OfficeIMO\OfficeIMO.Word\OfficeIMO.Word.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
